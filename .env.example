# Copia este archivo como .env.
# Con clave de API (https://console.anthropic.com):
ANTHROPIC_API_KEY=sk-ant-...
# Con tu suscripción Pro/Max: borra la línea de arriba e inicia sesión con `claude`.
# Con Codex/OpenAI por sesión: borra la línea de arriba, ejecuta `codex login`
# y pon JARVIS_MOTOR=codex abajo (sin esto, JARVIS_MOTOR=auto también lo
# detecta solo si no hay clave de Anthropic ni sesión de Claude).
# JARVIS_MOTOR=auto              # api | suscripcion | codex | auto

# Si no hay nada configurado y hay terminal interactiva, python -m jarvis
# pregunta cómo conectar (local / Claude / Codex) y guarda la elección acá;
# para volver a elegir usa python -m jarvis --reconfigurar-ia. Ninguna de
# las tres opciones pide ni guarda una clave: Claude y Codex usan la sesión
# que ya iniciaste en su CLI (`claude` / `codex login`); solo Ollama es
# totalmente local. Con JARVIS_MOTOR=api, JARVIS_PROVEEDOR elige entre:
# JARVIS_PROVEEDOR=anthropic      # anthropic (clave directa) | ollama
# JARVIS_OLLAMA_URL=http://localhost:11434   # si JARVIS_PROVEEDOR=ollama
# JARVIS_MODELO=qwen3:8b          # modelo local instalado, si JARVIS_PROVEEDOR=ollama

# Opcionales
# JARVIS_NOMBRE_USUARIO=señor
# JARVIS_MODELO=claude-opus-5-5
# JARVIS_ESFUERZO=low            # low | medium | high
# JARVIS_MODELO_WHISPER=small    # tiny | base | small | medium | large-v3
# JARVIS_IDIOMA=es
# JARVIS_CARPETA_DATOS=~/.jarvis
# JARVIS_PUERTO_HUD=8765         # puerto de la animación (python -m jarvis --hud)
# JARVIS_PALABRA_ACTIVACION=jarvis # solo responde cuando le llamas (vacío = a todo)
# JARVIS_SENSIBILIDAD_VOZ=3        # más bajo = detecta voz más baja (y más ruido)

# Voz de Jarvis (ver "Voz más natural" en el README)
# JARVIS_VOZ_MOTOR=auto            # auto | elevenlabs | kokoro | piper | macos | pyttsx3
# JARVIS_VOZ=                      # p. ej. "Jorge (Premium)" en macOS, "em_alex" en Kokoro o es_ES-davefx-medium en Piper
# JARVIS_VOZ_VELOCIDAD=165         # palabras por minuto
# ELEVENLABS_API_KEY=              # opcional, de pago: la voz más natural
# JARVIS_ELEVENLABS_VOZ=JBFqnCBsd6RMkjVDRZzb   # id de la voz (por defecto "George", británica y serena)
# JARVIS_ELEVENLABS_MODELO=eleven_multilingual_v2

# Música (ver "Música (YouTube)" en el README)
# YOUTUBE_API_KEY=                 # opcional: sin ella, "poné X" abre los resultados y elegís vos
